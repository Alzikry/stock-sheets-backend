generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Product — data master produk (Code Material)
// Sumber: kolom B, C, D di tab "Stock In/Out Summary"
// Urutan baris di sheet dipakai untuk matching antar tab,
// tapi di database kita simpan by "code" (nama item) sebagai kunci unik.
// ============================================
model Product {
  id        String   @id @default(cuid())
  code      String   @unique // contoh: "Stand Fan 1681" (kolom B / "Item")
  pcsPerKoli Int     // isi per koli, contoh: 2 (kolom C)
  kategori  String?  // contoh: "Kipas" (kolom D)
  rowOrder  Int      // posisi baris asli di spreadsheet, untuk matching Summary <-> Retur

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockSummaries    StockSummary[]
  dailyStockEntries StockDailyEntry[]
  dailyReturEntries ReturDailyEntry[]
  opnameItems       StockOpnameItem[]
}

// ============================================
// StockSummary — satu baris ringkasan per produk per periode sync
// Ini representasi "state saat ini" hasil hitung terakhir
// ============================================
model StockSummary {
  id              String   @id @default(cuid())
  product         Product  @relation(fields: [productId], references: [id])
  productId       String

  periodLabel     String   // contoh: "2026-07" (tahun-bulan, sesuai sheet aktif)
  stockHandKoli   Decimal  // Stock Hand awal (kolom E), satuan koli
  totalInKoli     Decimal  // total In sepanjang periode, satuan koli
  totalOutKoli    Decimal  // total Out sepanjang periode, satuan koli
  totalReturKoli  Decimal  // total Retur sepanjang periode, satuan koli

  endStockKoli    Decimal  // Stock Hand + totalIn - totalOut (belum + retur)
  endStockPcs     Decimal  // endStockKoli * pcsPerKoli (tampilan pcs, jalur terpisah)
  stockCountFinal Decimal  // endStockKoli + totalReturKoli (RETUR + STOCK AKHIR, satuan koli)

  lastSyncedAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, periodLabel]) // satu produk cuma punya 1 summary aktif per periode
}

// ============================================
// StockDailyEntry — riwayat In/Out harian per produk
// Sumber: pasangan kolom In/Out per tanggal di tab "Stock In/Out Summary"
// ============================================
model StockDailyEntry {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String

  date      DateTime // tanggal transaksi, contoh: 2026-07-13
  inKoli    Decimal  @default(0)
  outKoli   Decimal  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, date]) // satu produk cuma punya 1 baris per tanggal
}

// ============================================
// ReturDailyEntry — riwayat Retur harian per produk
// Sumber: kolom tanggal (In) di tab "Stock Retur"
// ============================================
model ReturDailyEntry {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String

  date      DateTime // tanggal retur
  returKoli Decimal  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, date])
}

// ============================================
// SyncLog — catatan riwayat setiap kali sync dijalankan
// Berguna untuk menampilkan "terakhir sync: ..." di dashboard
// dan untuk debugging jika ada sync yang gagal
// ============================================
model SyncLog {
  id           String   @id @default(cuid())
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  status       String   // "success" | "failed" | "running"
  triggeredBy  String   // "schedule" | "manual"
  rowsSynced   Int?
  errorMessage String?
}

// ============================================
// STOCK OPNAME v2 — REDESIGN TOTAL (Sesi #7)
// Model lama (StockOpnameSession per-produk + StockOpnamePartial) dari
// Sesi #6 DIHAPUS TOTAL dan digantikan struktur 3-level di bawah ini:
//
//   StockOpnameSession (1 sesi opname, bisa cakup BANYAK produk)
//         |
//         v
//   StockOpnameItem (1 produk di dalam sesi itu, snapshot systemKoli)
//         |
//         v
//   StockOpnameEntry (banyak baris hitungan per produk, dari
//                      tim/sumber berbeda -- totalnya dijumlah)
//
// Alasan redesign: user mau 1 sesi bisa mencakup banyak produk (mirip
// referensi app "Cycle Count" milik user), TAPI produk ditambahkan
// manual satu-satu lewat search (BUKAN otomatis semua produk sekaligus).
// Dan tiap produk dalam sesi bisa dihitung oleh lebih dari satu
// tim/sumber -- makanya perlu level ke-3 (Entry) untuk baris2 hitungan.
// ============================================

// ============================================
// StockOpnameSession — satu sesi opname stock, bisa mencakup banyak
// produk (lewat StockOpnameItem di bawahnya). Nama sesi auto-generate
// dari tanggal saat dibuat, format "Stock Opname DD/MM/YY" (dibuat di
// level aplikasi/backend, bukan default database).
// ============================================
model StockOpnameSession {
  id     String @id @default(cuid())
  name   String // contoh: "Stock Opname 23/07/26"

  status String @default("open") // "open" (Berjalan) | "final" (Final)

  finalizedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items StockOpnameItem[]
}

// ============================================
// StockOpnameItem — satu produk di dalam satu StockOpnameSession.
// systemKoli di-snapshot SAAT PRODUK INI DITAMBAHKAN ke sesi (bukan
// dihitung ulang tiap saat), supaya kalau ada sync baru di tengah
// proses opname, angka pembanding tidak berubah sendiri.
//
// countedKoli TOTAL untuk produk ini TIDAK disimpan sebagai kolom di
// sini -- selalu dihitung on-the-fly dari SUM semua StockOpnameEntry
// yang terhubung ke item ini (lihat helper sumEntries() di kode
// backend). Ini supaya tidak ada 2 sumber kebenaran yang bisa
// tidak-sinkron (kolom tersimpan vs data entry asli).
// ============================================
model StockOpnameItem {
  id        String  @id @default(cuid())
  session   StockOpnameSession @relation(fields: [sessionId], references: [id])
  sessionId String

  product   Product @relation(fields: [productId], references: [id])
  productId String

  systemKoli Decimal // snapshot StockSummary.stockCountFinal saat item ini ditambahkan

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries StockOpnameEntry[]

  @@unique([sessionId, productId]) // 1 produk cuma bisa 1x ditambahkan per sesi (banyak entry di dalamnya, bukan banyak item duplikat)
}

// ============================================
// StockOpnameEntry — satu baris hitungan manual untuk 1 produk di dalam
// 1 sesi. Bisa lebih dari 1 entry per item (misal dihitung oleh tim
// berbeda), totalnya dijumlah di level aplikasi untuk dapat total per
// item.
// ============================================
model StockOpnameEntry {
  id     String @id @default(cuid())
  item   StockOpnameItem @relation(fields: [itemId], references: [id])
  itemId String

  countedKoli Decimal // hasil hitung manual baris ini, satuan koli
  note        String? // opsional, misal "hitungan team A"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
